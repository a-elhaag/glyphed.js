{
  "name": "glyphed.js",
  "version": "2.0.0",
  "description": "Renders text, icons, annotations and charts as animated hand-drawn SVG",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "showcase": "npm run build && node docs/social/showcase/render.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-elhaag/glyphed.js.git"
  },
  "homepage": "https://github.com/a-elhaag/glyphed.js#readme",
  "bugs": "https://github.com/a-elhaag/glyphed.js/issues",
  "keywords": [
    "handwriting",
    "svg",
    "animation",
    "text",
    "typography",
    "icons",
    "hand-drawn",
    "sketch",
    "charts",
    "annotation"
  ],
  "author": "Anas <anaselhaag@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
