{
  "name": "strokes-js",
  "version": "0.2.1",
  "description": "Renders text as animated hand-drawn SVG",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-elhaag/strokes.js.git"
  },
  "homepage": "https://github.com/a-elhaag/strokes.js#readme",
  "bugs": "https://github.com/a-elhaag/strokes.js/issues",
  "keywords": [
    "handwriting",
    "svg",
    "animation",
    "text",
    "typography"
  ],
  "author": "Anas <anaselhaag@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
